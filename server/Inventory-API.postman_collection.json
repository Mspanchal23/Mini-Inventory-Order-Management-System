    {
      "name": "Orders",
      "item": [
        {
          "name": "Create order (duplicate lines merged)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const order = pm.response.json().data;",
                  "pm.collectionVariables.set('orderId', order._id);",
                  "pm.collectionVariables.set('customerId', order.customer);",
                  "pm.test('Status is Pending', () => pm.expect(order.status).to.eql('Pending'));",
                  "pm.test('Duplicate lines merged', () => { pm.expect(order.items).to.have.length(1); pm.expect(order.items[0].quantity).to.eql(3); });",
                  "pm.test('Total calculated by server', () => pm.expect(order.totalAmount).to.eql(order.items[0].unitPrice * 3));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"name\": \"Postman Customer\",\n    \"phone\": \"+91 90000 00000\",\n    \"email\": \"postman@example.com\",\n    \"address\": \"1 API Street, Ahmedabad, Gujarat\"\n  },\n  \"items\": [\n    {\n      \"product\": \"{{productId}}\",\n      \"quantity\": 2\n    },\n    {\n      \"product\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"notes\": \"Created from Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "Creates a Pending order. The same product is sent twice (2 + 1) and is merged into one line of 3. To reuse an existing customer, add `\"id\": \"<customerId>\"` inside `customer`."
          },
          "response": []
        },
