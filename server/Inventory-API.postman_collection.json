{
  "info": {
    "name": "Mini Inventory & Order Management API",
    "description": "REST API for the Mini Inventory & Order Management System.\n\n**Setup:** start the server (`npm run dev`), optionally `npm run seed`, then use **Run collection**. Requests are ordered so ids created by earlier requests (productId, orderId, customerId) are saved into collection variables and reused. Each run uses a fresh SKU, so it can be run repeatedly.\n\nThe \"Tricky cases\" folder demonstrates stock, status and validation rules and asserts the expected status codes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "sku",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create product",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('sku', 'PM-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const product = pm.response.json().data;",
                  "pm.collectionVariables.set('productId', product._id);",
                  "pm.test('SKU is upper-cased', () => pm.expect(product.sku).to.eql(product.sku.toUpperCase()));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Lamp\",\n  \"sku\": \"{{sku}}\",\n  \"price\": 499.5,\n  \"stock\": 5,\n  \"category\": \"Lighting\",\n  \"status\": \"Active\",\n  \"description\": \"Created from Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "description": "Creates a product with stock 5. SKU is generated per run and saved with the new productId."
          },
          "response": []
        },
        {
          "name": "List products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has pagination meta', () => pm.expect(pm.response.json().meta).to.have.property('total'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=10&search=lamp&sortBy=createdAt&order=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": "lamp",
                  "description": "Name, SKU or category"
                },
                {
                  "key": "category",
                  "value": "Lighting",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "Active",
                  "description": "Active | Inactive",
                  "disabled": true
                },
                {
                  "key": "sortBy",
                  "value": "createdAt",
                  "description": "name | sku | price | stock | category | createdAt | updatedAt"
                },
                {
                  "key": "order",
                  "value": "desc",
                  "description": "asc | desc"
                }
              ]
            },
            "description": "Supports pagination, search, filters and sorting."
